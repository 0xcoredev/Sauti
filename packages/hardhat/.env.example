# Mezo Testnet private key (with testnet BTC from faucet)
MEZO_TESTNET_PRIVATE_KEY=0xyour_testnet_private_key_here

# Optional: custom RPC (default: https://rpc.test.mezo.org)
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org

# MUSD and MEZO token addresses on Mezo testnet
# Replace with official addresses from mezo-org/musd repo
MUSD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
MEZO_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Reward rate in basis points (100 = 1%)
SAUTI_REWARD_BPS=100

# Optional: Base mainnet deployment
BASE_RPC_URL=https://mainnet.base.org
BASE_PRIVATE_KEY=
