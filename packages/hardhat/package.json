{
  "name": "@sauti/hardhat",
  "version": "0.1.0",
  "description": "Sauti smart contracts — voice-powered MUSD remittances on Mezo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:mezo": "hardhat run scripts/deploy.ts --network mezotestnet",
    "deploy:base": "hardhat run scripts/deploy.ts --network base",
    "verify:mezo": "hardhat verify --network mezotestnet",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.18",
    "solhint": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
